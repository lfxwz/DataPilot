FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    MPLBACKEND=Agg \
    MPLCONFIGDIR=/tmp/matplotlib

USER 0:0

RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --timeout 120 --retries 10 \
    numpy==2.3.2 \
    pandas==2.3.1 \
    scipy==1.16.1 \
    scikit-learn==1.7.1 \
    statsmodels==0.14.5 \
    plotly==6.3.0 \
    matplotlib==3.10.5 \
    seaborn==0.13.2 \
    openpyxl==3.1.5 \
    pyarrow==21.0.0 \
    polars==1.32.3 \
    xgboost==3.0.4 \
    lightgbm==4.6.0 \
    sympy==1.14.0 \
    networkx==3.5

RUN python -m pip install --timeout 120 --retries 10 \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.7.1

RUN groupadd --system --gid 10001 sandbox \
    && useradd --system --uid 10001 --gid sandbox --home-dir /nonexistent sandbox

COPY runner.py /opt/datapilot/runner.py

USER 10001:10001
WORKDIR /tmp

CMD ["python", "-c", "import time; time.sleep(2147483647)"]
