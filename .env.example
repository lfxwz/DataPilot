DATAPILOT_ENVIRONMENT=development
DATAPILOT_LOG_LEVEL=INFO
DATAPILOT_API_HOST=0.0.0.0
DATAPILOT_API_PORT=8000
DATAPILOT_CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
DATAPILOT_DATABASE_URL=postgresql+psycopg://datapilot_ro:local-read-only@127.0.0.1:5432/analytics
DATAPILOT_METADATA_DATABASE_URL=postgresql+psycopg://datapilot_metadata:local-metadata-only@127.0.0.1:5432/analytics
DATAPILOT_DATA_LOADER_DATABASE_URL=postgresql://analytics_owner:local-owner-only@127.0.0.1:5432/analytics
DATAPILOT_ENABLE_QUERY_API=true
DATAPILOT_ENABLE_AGENT_API=true
DATAPILOT_SQL_SAFETY_ENABLED=true
DATAPILOT_SQL_DIALECT=postgres
DATAPILOT_SQL_ALLOWED_SCHEMAS=["olist"]
DATAPILOT_SQL_MAX_ROWS=1000
DATAPILOT_SQL_STATEMENT_TIMEOUT_MS=15000
DATAPILOT_SQL_MAX_RETRIES=2

# Configure exactly one OpenAI-compatible provider when the LLM layer is added.
# Never commit real credentials.
DATAPILOT_LLM_BASE_URL=https://api.deepseek.com
DATAPILOT_LLM_API_KEY=
# Optional local-development alternative to DATAPILOT_LLM_API_KEY.
# The file is parsed for one literal assignment and is never imported or executed.
DATAPILOT_LLM_CREDENTIALS_FILE=
DATAPILOT_LLM_CREDENTIALS_VARIABLE=OPENAI_API_KEY
DATAPILOT_LLM_MODEL=deepseek-v4-flash
DATAPILOT_LLM_TIMEOUT_SECONDS=60
DATAPILOT_LLM_MAX_RETRIES=2
# Structured JSON/code generation defaults to non-thinking mode to reduce empty JSON responses.
DATAPILOT_LLM_THINKING_ENABLED=false

# Generated code is operator-gated and runs as a fresh process in one persistent container.
DATAPILOT_ENABLE_GENERATED_PYTHON=true
DATAPILOT_SANDBOX_CONTAINER_NAME=datapilot-python-runtime
DATAPILOT_SANDBOX_TIMEOUT_SECONDS=45
DATAPILOT_SANDBOX_MEMORY_MB=4096
DATAPILOT_SANDBOX_CPU_COUNT=4
